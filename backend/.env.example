# PostgreSQL Database Configuration
# For local development:
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/pothole_detection

# Alternative: Use individual parameters (uncomment if preferred)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pothole_detection
# DB_USER=postgres
# DB_PASSWORD=your_password

# Features file path
FEATURES_FILE=/app/features.yaml
